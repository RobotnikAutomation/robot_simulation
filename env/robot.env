# Runtime configuration for `docker compose -f runtime/docker-compose.yaml up`
# This file is loaded through `env_file` and translated by `runtime-entrypoint.sh`
# into the launch arguments expected by:
#   ros2 launch robotnik_simulation_bringup bringup_complete.launch.py

# Core robot selection
ROBOT_ID=robot1
ROBOT=rbwatcher
ROBOT_MODEL=rbwatcher

# Optional explicit xacro path. Leave empty to use the launch default.
ROBOT_XACRO_PATH=

# Simulation behaviour
USE_GUI=true                        # for use gzclient for visualization
USE_RVIZ=true                       # for use rviz2 for visualization
LOW_PERFORMANCE_SIMULATION=true     # for use low-quality rendering and physics for better performance on less powerful machines
RUN_MOVEIT=false                    # Arm selection (if applicable)
ARM_TYPE=ur10e                      # ur10e, ur5e, ur3e, none

# World selection
# Use WORLD for built-in worlds from robotnik_gazebo_ignition/worlds:
#   demo, empty, ionic, lightweight_scene
WORLD=demo

# Optional explicit world path. If set, it takes precedence over WORLD.
WORLD_PATH=

# Optional custom frame prefix. Leave empty to use `<robot_id>_`.
FRAME_PREFIX=
