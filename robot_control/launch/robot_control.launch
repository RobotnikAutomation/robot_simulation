<?xml version="1.0"?>
<launch>

  <arg name="id_robot" default="$(optenv ROBOT_ID robot)"/>
  <arg name="prefix" default="$(arg id_robot)_"/>
  <arg name="robot_model" default="$(optenv ROBOT_MODEL summit_xl)"/>

  <!-- Common parameters -->
  <arg name="kinematics" default="$(optenv ROBOT_KINEMATICS skid)"/>
  <arg name="wheel_diameter" default="$(optenv ROBOT_WHEEL_DIAMETER 0.22)"/>
  <arg name="track_width" default="$(optenv ROBOT_TRACK_WIDTH 0.439)"/>
  <arg name="wheel_base" default="$(optenv ROBOT_WHEEL_BASE 0.430)"/>
  <arg name="odom_frame" default="$(arg prefix)odom"/>
  <arg name="base_frame" default="$(arg prefix)base_footprint"/>
  <arg name="cmd_vel" default="robotnik_base_control/cmd_vel"/>
  <arg name="cmd_vel_unsafe" default="robotnik_base_control/cmd_vel_unsafe"/>
  <arg name="controller" default="$(optenv ROBOT_CONTROLLER robotnik_base_control)"/>
  <arg name="odom_broadcast_tf" default="true"/>
  <arg name="ros_planar_move_plugin" default="false"/>
  <arg name="robot_has_safety" default="false"/>
  
  <!-- Only used by rb1_base and theron -->
  <arg name="has_elevator" default="false"/>
  <arg name="robot_has_brakes" default="false"/>

  <!-- Load generic robot control params-->
  <rosparam file="$(find robot_sim)/robot_control/config/kinematics/$(arg kinematics)_control.yaml" command="load" subst_value="true"/>
  <!-- Load specific robot control params -->
  <rosparam file="$(find robot_sim)/robot_control/config/profiles/$(arg robot_model)_profile.yaml" command="load" subst_value="true"/>

  <!-- Load kinematic controller -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="
	  $(arg controller)
    joint_read_state_controller
    ">
  </node>

  <!-- Load twist mux -->
  <node pkg="twist_mux" type="twist_mux" name="twist_mux">
    <rosparam command="load" file="$(find robot_sim)/robot_control/config/twist_mux.yaml" />
    <remap if="$(arg robot_has_safety)" from="cmd_vel_out" to="$(arg cmd_vel_unsafe)" />
    <remap unless="$(arg robot_has_safety)" from="cmd_vel_out" to="$(arg cmd_vel)" />
  </node>

</launch>
