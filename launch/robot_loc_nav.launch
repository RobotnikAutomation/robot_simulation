<?xml version="1.0"?>
<launch>

  <!-- rb1_base, rb_theron, summit_xl, summit_xl_steel, rbkairos, rbvogui, rbvogui_xl, rbvogui_6w, rbrobout-->
  <arg name="robot_model" default="summit_xl"/>
  <!-- arg to config the launch file-->
  <arg name="robot_id" default="$(optenv ROBOT_ID robot)"/>
  <arg name="prefix" default="$(arg robot_id)_"/>
  <arg name="sim_world" default="$(optenv ROBOT_SIM_WORLD willow_garage)"/>
  <arg name="x_init_pose" default="$(optenv ROBOT_SIM_X_POSE 0)"/>
  <arg name="y_init_pose" default="$(optenv ROBOT_SIM_Y_POSE 0)"/>
  <arg name="z_init_pose" default="$(optenv ROBOT_SIM_Z_POSE 0)"/>
  <arg name="kinematics" default="$(optenv ROBOT_KINEMATICS skid_4w)"/>
  
  <arg name="launch_robot_ekf_localization" default="false"/>
  <arg name="robot_ekf_localization_mode" default="odom"/>
  <arg name="launch_move_base" default="true"/>
  <arg name="launch_amcl_and_mapserver" default="true"/>
  <arg name="launch_gmapping" default="false"/>
  <arg name="map_file" default="$(arg sim_world)/$(arg sim_world).yaml"/>

    <!-- move base -->
    <include if="$(arg launch_move_base)" file="$(find robot_sim)/launch/navigation/move_base.launch">
      <arg name="robot_model" value="$(arg robot_model)"/>
      <arg name="kinematics" value="$(arg kinematics)"/>
    </include>

    <!-- robot_localization nodes, publishes transformation world->odom->base_footprint -->
    <include if="$(arg launch_robot_ekf_localization)" file="$(find robot_sim)/launch/localization/robot_localization_$(arg robot_ekf_localization_mode).launch">
        <arg name="prefix" value="$(arg prefix)"/>
        <arg name="id_robot" value="$(arg robot_id)"/>
    </include>

    <!-- amcl and map server base-->
    <include if="$(arg launch_amcl_and_mapserver)" file="$(find robot_sim)/launch/localization/map_server.launch">
        <arg name="prefix" value="$(arg prefix)"/>
        <arg name="map_file" value="$(arg map_file)"/>
        <arg name="id_robot" value="$(arg robot_id)"/>
    </include>
    <include if="$(arg launch_amcl_and_mapserver)" file="$(find robot_sim)/launch/localization/amcl.launch">
        <arg name="prefix" value="$(arg prefix)"/>
        <arg name="id_robot" value="$(arg robot_id)"/>
        <arg name="kinematics" value="$(arg kinematics)"/>
        <arg name="x_init_pose" value="$(arg x_init_pose)"/>
        <arg name="y_init_pose" value="$(arg y_init_pose)"/>
        <arg name="z_init_pose" value="$(arg z_init_pose)"/>
    </include>

    <!-- gmapping -->
    <include if="$(arg launch_gmapping)" file="$(find robot_sim)/launch/localization/slam_gmapping.launch">
        <arg name="prefix" value="$(arg prefix)"/>
        <arg name="id_robot" value="$(arg robot_id)"/>
    </include>
</launch>
  