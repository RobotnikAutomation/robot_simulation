        <mass>1.0</mass>
        <inertia> 
          <ixy>0.0</ixy>      
          <ixz>0.0</ixz>        
          <iyz>0.0</iyz>       
        </inertia>
      </inertial>

      <visual name="windows_visual">
          <geometry>
            <mesh>
              <uri>source/windows.obj</uri>
            </mesh>
          </geometry>
